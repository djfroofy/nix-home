[general]
framerate = 60
autosens = 1
bar_width = 2
bar_spacing = 1

[input]
method = portaudio
; For system audio on macOS, install a loopback device and set one of these:
source = "Background Music"
; source = "BlackHole 2ch"

[output]
method = ncurses
channels = stereo

[smoothing]
monstercat = 1
waves = 0
gravity = 100
noise_reduction = 77

[color]
background = default
foreground = default
gradient = 0
